{
  "name": "marka",
  "productName": "marka",
  "version": "1.0.0",
  "private": true,
  "description": "My Electron application description",
  "keywords": [],
  "homepage": "https://github.com/borisonekenobi/marka#readme",
  "bugs": {
    "url": "https://github.com/borisonekenobi/marka/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisonekenobi/marka.git"
  },
  "license": "MIT",
  "author": "Boris Vasilev <44681924+borisonekenobi@users.noreply.github.com>",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "ng": "ng",
    "start": "npm run build && electron-forge start",
    "start:dev": "npm run build:dev && electron-forge start",
    "dev": "nodemon --watch src --ext ts,html,css --exec \"npm run start:dev\"",
    "build": "npm run build:ng && npm run build:electron && npm run build:preload",
    "build:dev": "npm run build:ng-dev && npm run build:electron && npm run build:preload",
    "build:ng": "ng build",
    "build:ng-dev": "ng build --configuration development",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "lint": "echo \"No linting configured\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@marka-editor/markdown": "^1.0.5",
    "angular-svg-icon": "^19.1.1",
    "chardet": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "iconv-lite": "^0.7.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@forkprince/electron-forge-maker-appimage": "^1.0.2",
    "@forkprince/electron-forge-maker-targz": "^1.0.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^25.6.0",
    "electron": "^41.3.0",
    "jsdom": "^28.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
